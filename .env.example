# Example only: this key is fake. Copy to .env and put your real key there (never commit .env),
# or set these as user environment variables (needed for the scheduled sync).
MASSIVE_API_KEY=FAKE_massive_key_0123456789abcdef

# Your plan: free | starter | developer | advanced
MASSIVE_TIER=free

# Optional overrides
# MASSIVE_RPM=5
# MASSIVE_DB=C:/Users/you/MassiveData/massive.db
# MASSIVE_MAX_REQUESTS_PER_RUN=250
# MASSIVE_MAX_REQUESTS_PER_DAY=2000

# Second feed: Alpaca (stocks and crypto). Crypto needs no key; stocks need a free Alpaca
# account's API keys (paper-trading keys work). Set them as user environment variables or in
# .env (never commit it). Fake values:
# ALPACA_API_KEY_ID=FAKE_alpaca_key_id
# ALPACA_API_SECRET_KEY=FAKE_alpaca_secret
# ALPACA_PLAN=basic            # basic (free) | algo_trader_plus
# ALPACA_PAPER=1               # 1: paper-trading keys, 0: live-account keys
# ALPACA_FEED=sip              # sip (every US exchange) | iex
# ALPACA_CRYPTO_LOC=us-1       # us-1 Kraken (US) | eu-1 Kraken (EU) | us Alpaca's own venue
# ALPACA_MAX_REQUESTS_PER_RUN=3000
# ALPACA_MAX_REQUESTS_PER_DAY=30000

# Several feeds: each span of a symbol is downloaded by one feed only, ranked by resolution,
# then audited accuracy, then this order. Audits per feed run (after new data / random):
# SOURCE_PRIORITY=massive,alpaca
# AUDITS_PER_RUN=2
# AUDITS_RANDOM_PER_RUN=1
